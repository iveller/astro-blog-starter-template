---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Veller Partners — Investment Banking & Financial Advisory">
  <Header />
  <main>
    <!-- Hero -->
    <section class="hero">
      <div class="hero-content">
        <h1>Veller Partners</h1>
        <p class="tagline">Investment Banking & Financial Advisory</p>
        <p class="subtitle">Trusted strategic and financial advice for growth-focused companies.</p>
        <a href="#contact" class="cta-btn">Get in Touch</a>
      </div>
    </section>

    <!-- Services -->
    <section class="services">
      <h2>Our Services</h2>
      <div class="services-grid">
        <div class="service-card">
          <h3>M&A Advisory</h3>
          <p>Buy-side and sell-side merger & acquisition advisory, from strategy to closing.</p>
        </div>
        <div class="service-card">
          <h3>Capital Raising</h3>
          <p>Debt and equity capital solutions tailored to your growth stage and objectives.</p>
        </div>
        <div class="service-card">
          <h3>Strategic Consulting</h3>
          <p>Corporate strategy, valuation, and financial modeling to drive informed decisions.</p>
        </div>
        <div class="service-card">
          <h3>Restructuring</h3>
          <p>Financial restructuring and turnaround advisory to restore stability and value.</p>
        </div>
      </div>
    </section>

    <!-- About -->
    <section class="about">
      <h2>About Us</h2>
      <p>Veller Partners is a boutique investment banking firm providing senior-level attention
        to every engagement. We combine deep industry expertise with a commitment to delivering
        results that align with our clients' long-term goals.</p>
    </section>

    <!-- Contact -->
    <section id="contact" class="contact">
      <h2>Contact Us</h2>
      <p>Ready to discuss how we can help? Reach out for a confidential consultation.</p>
      <a href="mailto:info@vellerpartners.com" class="cta-btn">info@vellerpartners.com</a>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  :global(body) { margin: 0; font-family: Georgia, 'Times New Roman', serif; color: #1a1a2e; }
  .hero {
    background: linear-gradient(135deg, #0f1923 0%, #1a2a3a 100%);
    color: #fff; text-align: center; padding: 6rem 2rem;
  }
  .hero h1 { font-size: 3rem; margin: 0 0 0.5rem; letter-spacing: 2px; }
  .tagline { font-size: 1.3rem; color: #c5a572; margin: 0 0 1rem; font-style: italic; }
  .subtitle { font-size: 1.1rem; opacity: 0.85; max-width: 600px; margin: 0 auto 2rem; }
  .cta-btn {
    display: inline-block; padding: 0.8rem 2rem; background: #c5a572; color: #0f1923;
    text-decoration: none; border-radius: 4px; font-weight: bold; font-family: sans-serif;
  }
  .cta-btn:hover { background: #d4b884; }
  .services { padding: 4rem 2rem; max-width: 1000px; margin: 0 auto; }
  .services h2 { text-align: center; font-size: 2rem; margin-bottom: 2rem; }
  .services-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 2rem; }
  .service-card { padding: 2rem; border: 1px solid #e0e0e0; border-radius: 8px; text-align: center; }
  .service-card h3 { color: #0f1923; margin-bottom: 0.5rem; }
  .service-card p { color: #555; line-height: 1.6; }
  .about { background: #f5f5f5; padding: 4rem 2rem; text-align: center; }
  .about h2 { font-size: 2rem; margin-bottom: 1rem; }
  .about p { max-width: 700px; margin: 0 auto; line-height: 1.8; color: #444; }
  .contact { background: #0f1923; color: #fff; text-align: center; padding: 4rem 2rem; }
  .contact h2 { font-size: 2rem; margin-bottom: 1rem; }
  .contact p { opacity: 0.85; margin-bottom: 1.5rem; }
  .contact .cta-btn { background: #c5a572; color: #0f1923; }
</style>
