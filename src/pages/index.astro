<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Veller Partners LLC | Institutional Capital & Investment Solutions</title>
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            background: linear-gradient(135deg, #0a0e27 0%, #1a1f3a 100%);
            color: #e8eef7;
            line-height: 1.6;
            overflow-x: hidden;
        }
        
        header {
            background: rgba(10, 14, 39, 0.95);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            position: sticky;
            top: 0;
            z-index: 1000;
            padding: 1.2rem 0;
        }
        
        .navbar {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .logo {
            font-size: 1.5rem;
            font-weight: 700;
            letter-spacing: -0.5px;
            color: #ffffff;
            text-decoration: none;
        }
        
        nav a {
            color: #b4bcc8;
            text-decoration: none;
            margin-left: 2.5rem;
            font-size: 0.95rem;
            transition: color 0.3s ease;
        }
        
        nav a:hover {
            color: #ffffff;
        }
        
        .hero {
            max-width: 1200px;
            margin: 0 auto;
            padding: 6rem 2rem;
            text-align: center;
            min-height: 70vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
        }
        
        .hero h1 {
            font-size: 3.5rem;
            margin-bottom: 1.5rem;
            font-weight: 700;
            background: linear-gradient(135deg, #ffffff 0%, #b4bcc8 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            letter-spacing: -1px;
        }
        
        .hero p {
            font-size: 1.25rem;
            color: #a8b2c1;
            max-width: 600px;
            margin: 0 auto 2rem;
            line-height: 1.8;
        }
        
        .cta-button {
            display: inline-block;
            background: linear-gradient(135deg, #4a5f8f 0%, #3a4f7f 100%);
            color: #ffffff;
            padding: 1rem 2.5rem;
            border-radius: 6px;
            text-decoration: none;
            font-weight: 600;
            font-size: 1rem;
            transition: all 0.3s ease;
            border: 1px solid rgba(255, 255, 255, 0.1);
            margin-top: 1rem;
        }
        
        .cta-button:hover {
            background: linear-gradient(135deg, #5a6f9f 0%, #4a5f8f 100%);
            border-color: rgba(255, 255, 255, 0.2);
            transform: translateY(-2px);
        }
        
        .section {
            max-width: 1200px;
            margin: 0 auto;
            padding: 5rem 2rem;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
        }
        
        .section h2 {
            font-size: 2.2rem;
            margin-bottom: 3rem;
            text-align: center;
            font-weight: 700;
        }
        
        .section-content {
            max-width: 800px;
            margin: 0 auto;
            text-align: center;
        }
        
