    <style is:inline>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            background: linear-gradient(135deg, #0a0e27 0%, #1a1f3a 100%);
            color: #e8eef7;
            line-height: 1.6;
            overflow-x: hidden;
        }
        header {
            background: rgba(10, 14, 39, 0.95);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            position: sticky;
            top: 0;
            z-index: 1000;
            padding: 1.2rem 0;
        }
        .navbar {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .logo {
            display: flex;
            align-items: center;
            gap: 0.8rem;
            font-size: 1.5rem;
            font-weight: 700;
            letter-spacing: -0.5px;
            color: #ffffff;
            text-decoration: none;
        }
        .logo img {
            width: 42px;
            height: 42px;
        }
        .hero-logo {
            width: 150px;
            height: 150px;
            margin-bottom: 2rem;
        }
        nav a {
            color: #b4bcc8;
            text-decoration: none;
            margin-left: 2.5rem;
            font-size: 0.95rem;
            transition: color 0.3s ease;
        }
        nav a:hover {
            color: #ffffff;
        }
        .hero {
            max-width: 1200px;
            margin: 0 auto;
            padding: 6rem 2rem;
            text-align: center;
            min-height: 70vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
        }
        .hero h1 {
            font-size: 3.5rem;
            margin-bottom: 1.5rem;
            font-weight: 700;
            background: linear-gradient(135deg, #ffffff 0%, #b4bcc8 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            letter-spacing: -1px;
        }
        .hero p {
            font-size: 1.25rem;
            color: #a8b2c1;
            max-width: 600px;
            margin: 0 auto 2rem;
            line-height: 1.8;
        }
        .cta-button {
            display: inline-block;
            background: linear-gradient(135deg, #4a5f8f 0%, #3a4f7f 100%);
            color: #ffffff;
            padding: 1rem 2.5rem;
            border-radius: 6px;
            text-decoration: none;
            font-weight: 600;
            font-size: 1rem;
            transition: all 0.3s ease;
            border: 1px solid rgba(255, 255, 255, 0.1);
            margin-top: 1rem;
        }
        .cta-button:hover {
            background: linear-gradient(135deg, #5a6f9f 0%, #4a5f8f 100%);
            border-color: rgba(255, 255, 255, 0.2);
            transform: translateY(-2px);
        }
        .section {
            max-width: 1200px;
            margin: 0 auto;
            padding: 5rem 2rem;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
        }
        .section h2 {
            font-size: 2.2rem;
            margin-bottom: 3rem;
            text-align: center;
            font-weight: 700;
        }
        .section-content {
            max-width: 800px;
            margin: 0 auto;
            text-align: center;
        }
        .section-content p {
            font-size: 1.05rem;
            color: #b4bcc8;
            margin-bottom: 1.5rem;
            line-height: 1.8;
        }
        .pillars {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 2rem;
            margin-top: 3rem;
        }
        .pillar {
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(255, 255, 255, 0.08);
            padding: 2rem;
            border-radius: 8px;
            transition: all 0.3s ease;
        }
        .pillar:hover {
            background: rgba(255, 255, 255, 0.04);
            border-color: rgba(255, 255, 255, 0.15);
            transform: translateY(-4px);
        }
        .pillar h3 {
            font-size: 1.25rem;
            margin-bottom: 1rem;
            color: #ffffff;
        }
        .pillar p {
            color: #a8b2c1;
            font-size: 0.95rem;
        }
        .contact-section {
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 8px;
            padding: 3rem;
            text-align: center;
            max-width: 600px;
            margin: 3rem auto 0;
        }
        .contact-section h3 {
            font-size: 1.3rem;
            margin-bottom: 1.5rem;
        }
        .contact-info {
            margin: 1.5rem 0;
        }
        .contact-info a {
            color: #4a5f8f;
            text-decoration: none;
            font-weight: 600;
            transition: color 0.3s ease;
        }
        .contact-info a:hover {
            color: #5a6f9f;
        }
        footer {
            border-top: 1px solid rgba(255, 255, 255, 0.05);
            padding: 3rem 2rem;
            text-align: center;
            color: #7a8294;
            font-size: 0.9rem;
        }
        .footer-content {
            max-width: 1200px;
            margin: 0 auto;
        }
        .footer-links {
            margin-bottom: 1.5rem;
        }
        .footer-links a {
            color: #7a8294;
            text-decoration: none;
            margin: 0 1.5rem;
            transition: color 0.3s ease;
        }
        .footer-links a:hover {
            color: #b4bcc8;
        }
        @media (max-width: 768px) {
            .hero h1 {
                font-size: 2.2rem;
            }
            .hero p {
                font-size: 1rem;
            }
            .section h2 {
                font-size: 1.8rem;
            }
            nav a {
                margin-left: 1.5rem;
                font-size: 0.85rem;
            }
            .navbar {
                padding: 0 1rem;
            }
            .section {
                padding: 3rem 1.5rem;
            }
        }
    </style>
</head>
<body>
    <header>
        <div class="navbar">
            <a href="/" class="logo"><img src="/logo.svg" alt="Veller Partners LLC logo"><span>Veller Partners LLC</span></a>
            <nav>
                <a href="#about">About</a>
                <a href="#approach">Approach</a>
                <a href="#contact">Contact</a>
            </nav>
        </div>
    </header>
    <section class="hero">
        <img class="hero-logo" src="/logo-full.svg" alt="Veller Partners LLC cube logo">
        <h1>Veller Partners</h1>
        <p>A private investment firm partnering with founders building category defining companies in AI and frontier technology.</p>
        <a href="#contact" class="cta-button">Get in Touch</a>
    </section>
    <section class="section" id="about">
        <h2>About the Firm</h2>
        <div class="section-content">
            <p>Veller Partners LLC is a private investment firm that structures and manages special purpose vehicles for direct investments in high growth technology companies. We work in close partnership with the founders we back and with the co investors who join us, and we take a concentrated approach: a small number of positions, entered with conviction, held with patience.</p>
            <p>The firm was founded by Ilya Veller, a finance professional with a background in investment management and corporate finance. We invest alongside established venture investors and maintain long term relationships with the management teams of our portfolio companies.</p>
        </div>
    </section>
    <section class="section" id="approach">
        <h2>How We Invest</h2>
        <div class="pillars">
            <div class="pillar">
                <h3>Access</h3>
                <p>We source opportunities through direct relationships with founders and lead investors, focusing on companies where we can secure meaningful allocations in competitive rounds.</p>
            </div>
            <div class="pillar">
                <h3>Structure</h3>
                <p>Each investment is held in a dedicated special purpose vehicle with clean terms, transparent economics, and institutional grade administration, banking, and reporting.</p>
            </div>
            <div class="pillar">
                <h3>Alignment</h3>
                <p>We invest our own capital in every vehicle we manage. Our co investors get the same terms we do, and we only do well when the investment does well.</p>
            </div>
        </div>
    </section>
    <section class="section" id="contact">
        <h2>Contact</h2>
        <div class="contact-section">
            <h3>For qualified investors and founders</h3>
            <div class="contact-info">
                <p><strong>Ilya Veller</strong></p>
                <p style="color: #a8b2c1;">Managing Partner</p>
                <a href="mailto:iv@vellerpartners.com">iv@vellerpartners.com</a>
            </div>
            <div class="contact-info">
                <p style="color: #a8b2c1;">Veller Partners LLC<br>New York, New York</p>
            </div>
            <div class="contact-info">
                <p style="margin-top: 1.5rem; color: #7a8294; font-size: 0.9rem;">
                    Inquiries from prospective investors are subject to confidentiality and applicable investor qualification requirements.
                </p>
            </div>
        </div>
    </section>
    <footer>
        <div class="footer-content">
            <div class="footer-links">
                <a href="/privacy">Privacy Policy</a>
                <a href="/terms">Terms of Service</a>
                <a href="#contact">Contact</a>
            </div>
            <p>&copy; 2026 Veller Partners LLC. All rights reserved.</p>
            <p style="margin-top: 1rem; font-size: 0.8rem; max-width: 700px; margin-left: auto; margin-right: auto;">
                Veller Partners LLC is a private investment firm. Nothing on this website constitutes an offer to sell, or a solicitation of an offer to buy, any security. Any such offer will be made only through definitive offering documents provided to qualified investors.
            </p>
        </div>
    </footer>
